# RentUFS Frontend Environment Variables
# Copy this file to .env for local development
# Set these as Environment Variables in Netlify for production

# Backend API URL
# For local development: http://localhost:5000
# For production: Your deployed backend URL (e.g., https://rentufs-api.onrender.com)
REACT_APP_API_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (required for Sign in with Google)
# Must match the GOOGLE_CLIENT_ID set on the backend.
# Create a Web application OAuth client at https://console.cloud.google.com/auth/clients
# Authorized JavaScript origins must include http://localhost:3000 and your production URL.
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
